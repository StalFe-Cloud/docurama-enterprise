}

model RetentionPolicy {
  id           String    @id @default(cuid())
  name         String
  scope        String
  retentionDays Int
  disposition  String    @default("DELETE") // DELETE | ANONYMIZE | ARCHIVE
  status       String    @default("ACTIVE") // ACTIVE | DRAFT
  lastSweepAt  DateTime?
