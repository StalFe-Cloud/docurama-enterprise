model LegalHold {
  id        String    @id @default(cuid())
  tenantId  String
  reason    String
  scope     String
  status    String    @default("ACTIVE") // ACTIVE | RELEASED
  issuedBy  String
  issuedAt  DateTime  @default(now())
  releasedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Consent {
  id          String    @id @default(cuid())
  subjectEmail String
  purpose     String
  source      String    @default("signup")
  grantedAt   DateTime  @default(now())
  status      String    @default("GRANTED") // GRANTED | WITHDRAWN
  withdrawnAt DateTime?
}

model Incident {
  id          String    @id @default(cuid())
  title       String
  severity    String    @default("SEV3") // SEV1 | SEV2 | SEV3
  status      String    @default("OPEN") // OPEN | CONTAINED | RESOLVED
  description String
  assignee    String
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
}

model AccessReview {
  id          String    @id @default(cuid())
  quarter     String
  reviewer    String
  scope       String
  status      String    @default("PENDING") // PENDING | COMPLETED
  findings    Int       @default(0)
  completedAt DateTime?
}

model Risk {
  id         String  @id @default(cuid())
  title      String
  category   String
  likelihood String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  impact     String  @default("MEDIUM") // LOW | MEDIUM | HIGH
  score      Int     @default(9)
  mitigation String?
  status     String  @default("OPEN") // OPEN | MITIGATED | ACCEPTED
  owner      String
}

model Change {
  id          String    @id @default(cuid())
  title       String
  type        String    @default("STANDARD") // STANDARD | EMERGENCY
  description String
  requestedBy String
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | IMPLEMENTED
  decidedBy   String?
  decisionAt  DateTime?
}

model Vendor {
  id          String    @id @default(cuid())
  name        String
  service     String
  riskLevel   String    @default("LOW") // LOW | MEDIUM | HIGH
  dpdSigned   Boolean   @default(false)
  lastAuditAt DateTime?
  status      String    @default("APPROVED") // APPROVED | REVIEW | REJECTED
}

model RestoreDrill {
  id          String    @id @default(cuid())
  scope       String
  rtoTarget   String
  rtoActual   String?
  result      String    @default("PASS") // PASS | PARTIAL | FAIL
  executedAt  DateTime  @default(now())
  notes       String?
}

model Subprocessor {
  id                String  @id @default(cuid())
  name              String
  purpose           String
  location          String
  dpaSigned         Boolean @default(true)
  transferMechanism String  @default("SCC")
}

/// A written compliance document: the customer-facing pack (DPA, privacy
/// policy, sub-processor list) and the internal ISMS set. Seeded from the
/// markdown catalogue in src/lib/compliance-library/ and editable in the
/// platform console. Only rows flagged isPublic are published to /docs/legal.
model ComplianceDocument {
  id            String    @id @default(cuid())
  key           String    @unique // stable catalogue id, drives idempotent sync
  title         String
  category      String    @default("Policy") // Policy | Agreement | Register | Plan | Notice
  owner         String    @default("Security")
  status        String    @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | RETIRED
  version       String    @default("1.0.0")
  locale        String    @default("en")
  summary       String?
  bodyMarkdown  String
  isPublic      Boolean   @default(false)
  effectiveFrom DateTime?
  nextReviewAt  DateTime?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Pipe-separated Control.ref values this document is evidence for,
  /// e.g. "SOC2-CC6.1|ISO-27001-A.5.15|GDPR-32". Matches the existing
  /// pipe-separated-list convention used elsewhere in this schema.
  controlRefs   String    @default("")

  versions ComplianceDocumentVersion[]

  @@index([status, category])
}

/// Immutable history. A new row is written on every content change, and each
/// one is mirrored into AuditEvent so the trail cannot be edited in place.
model ComplianceDocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      String
  bodyMarkdown String
  changedBy    String
  changeNote   String?
  createdAt    DateTime @default(now())

  document ComplianceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

// ─── Integrations ─────────────────────────────────────────────────────────────

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String?
  name        String
  prefix      String // e.g. dk_live_ab12
  secretHash  String?   // SHA-256 of the full key — enables real X-API-Key authentication
  scope       String    @default("READONLY") // READONLY | ENVELOPES | TEMPLATES | FULL
  status      String    @default("ACTIVE") // ACTIVE | REVOKED
  createdBy   String
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WebhookEndpoint {
  id            String    @id @default(cuid())
  tenantId      String
  url           String
  events        String // pipe-separated event list, "*" subscribes to all
  status        String    @default("ACTIVE") // ACTIVE | PAUSED | FAILING
  secretMasked  String
  successRate   Int       @default(100)
  lastDeliveryAt DateTime?
  createdAt     DateTime  @default(now())

  // Raw signing secret (whsec_…), kept retrievable because HMAC verification
  // on the receiver side needs the exact bytes. Never returned by any API -
  // only the masked preview and the one-time reveal at creation.
  secret        String?

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  event      String
  statusCode Int
  durationMs Int
  success    Boolean
  at         DateTime @default(now())

  // Retry engine: the exact payload that was POSTed is snapshotted so the
  // worker can re-deliver byte-identical bodies (receivers verify a stable
  // HMAC). Nullable for additive migration: pre-engine rows have no snapshot
  // and are skipped by the retry pass. attempts < 5 with nextAttemptAt in
  // the past = due for retry.
  payload       String?
  attempts      Int       @default(1)
  nextAttemptAt DateTime?
  claimToken    String?
  claimUntil    DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([success, attempts, nextAttemptAt])
  @@index([claimUntil])
}

model EnvelopeQuotaUsage {
  id        String   @id @default(cuid())
  tenantId  String
  periodKey String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, periodKey])
  @@index([tenantId, periodKey])
}

// ─── Audit & Ops ──────────────────────────────────────────────────────────────

model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String?
  subjectUserId String?
  tenantId    String?
  actor       String
  actorRole  String
  action     String
  resource   String
  tenantName String?
  severity   String   @default("INFO") // INFO | WARNING | CRITICAL
  ip         String
  detail     String?

  @@index([actorUserId, at])
  @@index([subjectUserId, at])
  @@index([tenantId, at])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  actorUserId String?
  subjectUserId String?
  tenantId    String?
  type        String
  severity String   @default("INFO") // INFO | LOW | MEDIUM | HIGH | CRITICAL
  actor    String
  ip       String
  blocked  Boolean  @default(true)
  detail   String?

  @@index([actorUserId, at])
  @@index([subjectUserId, at])
  @@index([tenantId, at])
}

model DailyStat {
  id               String   @id @default(cuid())
  date             String   @unique // YYYY-MM-DD
  envelopesCreated Int      @default(0)
  envelopesSealed  Int      @default(0)
  signersActive    Int      @default(0)
  activeTenants    Int      @default(0)
  mrrEur           Int      @default(0)
}

model PlatformSetting {
  id                  String   @id @default("singleton")
  smtpHost            String   @default("smtp.eu.mailprovider.io")
  smtpPort            Int      @default(587)
  smtpUser            String   @default("notifications@docurama.eu")
  smtpFrom            String   @default("Docurama Sign <notifications@docurama.eu>")
  smtpTls             Boolean  @default(true)
  tsaUrl              String   @default("https://timestamp.digicert.com")
  tsaReachable        Boolean  @default(true)
  certFingerprint     String   @default("3A:F2:88:1B:6C:9E:44:D0:A7:2E:5F:B1:C3:98:0D:64:71:AA:29:5C")
  certExpiryAt        DateTime
  signingConformance  String   @default("B-LT")
  trialLengthDays     Int      @default(14)
  maintenanceMode     Boolean  @default(false)
  featureFlags        String   @default("{\"smsDelivery\":true,\"bulkSend\":true,\"webhooks\":true,\"passkeys\":true,\"aiFieldDetect\":false,\"euResidencyOnly\":false}")
  provisioningState   String   @default("{}") // persisted provisioning state for docurama.eu emails/subdomains/DNS
  sweeperLastRunAt    DateTime @default(now())
  queueDepth          Int      @default(3)
  apiReplicas         Int      @default(2)
  diskUsedPct         Int      @default(41)
  lastDeployAt        DateTime @default(now())
  version             String   @default("4.2.1")
  auditChainSealedAt  DateTime @default(now())
  auditChainBlockHeight Int   @default(1842)
  updatedAt           DateTime @default(now())
}
